<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for vaultis.app/Contents/Info.plist; make-app.sh fills in the versions. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>vaultis</string>
    <key>CFBundleDisplayName</key>
    <string>vaultis</string>
    <!-- Matches ProjectDirs::from("dev", "vaultis", "vaultis"), so the app's data folder
         is ~/Library/Application Support/dev.vaultis.vaultis under either name. -->
    <key>CFBundleIdentifier</key>
    <string>dev.vaultis.vaultis</string>
    <key>CFBundleExecutable</key>
    <string>vaultis-gui</string>
    <key>CFBundleIconFile</key>
    <string>vaultis</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@NUMERIC_VERSION@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- The oldest macOS a Rust aarch64-apple-darwin binary runs on. -->
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>See LICENSE.</string>
</dict>
</plist>
